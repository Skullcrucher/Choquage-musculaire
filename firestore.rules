rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Liste blanche : seuls ces comptes Google peuvent lire/écrire quoi que
    // ce soit, même s'ils se connectent avec succès via Google Sign-In.
    // Pour ajouter quelqu'un plus tard : ajoute son email ici, virgule, et
    // redéploie (firebase deploy --only firestore:rules).
    function isAllowed() {
      return request.auth != null &&
             request.auth.token.email in [
               'bouvet.clement@gmail.com'
             ];
    }

    // Profils (pseudo + photo) : chacun lit tout le monde (pour le feed),
    // mais ne modifie que le sien.
    match /profiles/{uid} {
      allow read: if isAllowed();
      allow write: if isAllowed() && request.auth.uid == uid;
    }

    // Bibliothèque d'exercices et routines : partagées entre tous les
    // utilisateurs autorisés (comme une salle de sport commune).
    match /exercises/{exerciseId} {
      allow read, write: if isAllowed();
    }
    match /routines/{routineId} {
      allow read, write: if isAllowed();
    }

    // Séances : lecture ouverte à tout utilisateur autorisé (pour le feed),
    // création/modification/suppression réservées au propriétaire — sauf
    // le champ `props` (réactions 🤘) que n'importe quel utilisateur
    // autorisé peut modifier sur la séance de n'importe qui.
    match /workouts/{workoutId} {
      allow read: if isAllowed();
      allow create: if isAllowed()
                    && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isAllowed() && (
                      resource.data.owner_uid == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['props'])
                    );
      allow delete: if isAllowed()
                    && resource.data.owner_uid == request.auth.uid;

      match /sets/{setId} {
        allow read: if isAllowed();
        allow create: if isAllowed()
                      && request.resource.data.owner_uid == request.auth.uid;
        allow update, delete: if isAllowed()
                      && resource.data.owner_uid == request.auth.uid;
      }
    }
  }
}
