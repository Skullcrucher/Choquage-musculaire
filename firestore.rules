rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ouvert à tout compte connecté (email/mot de passe). La confidentialité
    // repose sur owner_uid : chacun ne lit que ses propres séances et
    // routines, plus les séances partagées sur le feed (shared == true) et
    // les routines publiques ou partagées avec lui par un ami.
    function isSignedIn() {
      return request.auth != null;
    }

    // Administrateur de l'app : peut modifier toute la bibliothèque
    // d'exercices et récupère les routines créées avant qu'elles
    // deviennent personnelles. Même email que ADMIN_EMAIL dans js/db.js.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bouvet.clement@gmail.com';
    }

    function workoutDoc(workoutId) {
      return get(/databases/$(database)/documents/workouts/$(workoutId)).data;
    }

    // Texte affiché aux autres utilisateurs : pas de < ni > (anti-injection
    // HTML, en plus de l'échappement fait par l'app).
    function isSafeText(value, maxLen) {
      return value is string && value.size() <= maxLen && !value.matches('.*[<>].*');
    }

    // Profils (pseudo + photo) : chacun lit tout le monde (feed, recherche
    // d'amis), mais ne modifie que le sien.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
                   && isSafeText(request.resource.data.get('display_name', ''), 30)
                   && isSafeText(request.resource.data.get('search_name', ''), 30);
      // Modération : l'administrateur peut vider un profil signalé.
      allow update: if isAdmin();
    }

    // Statut « à la salle » : présent tant qu'une séance est en cours (et
    // que l'utilisateur ne l'a pas masqué). Lisible par soi et par ses amis
    // (amitié acceptée) seulement.
    function isFriendOf(uid) {
      return exists(/databases/$(database)/documents/friendships/$(request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/friendships/$(request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid)).data.status == 'accepted';
    }
    match /presence/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isFriendOf(uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['since', 'last_seen', 'title', 'name'])
                    && request.resource.data.since is string
                    && request.resource.data.last_seen is string
                    && isSafeText(request.resource.data.get('title', ''), 80)
                    && isSafeText(request.resource.data.get('name', ''), 30);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Plans partagés : copie d'un plan (et de ses routines) visible par les
    // amis choisis ou par tous. Seul l'auteur écrit.
    match /shared_plans/{planId} {
      allow read: if isSignedIn() && (resource.data.owner_uid == request.auth.uid
                    || resource.data.visibility == 'public'
                    || request.auth.uid in resource.data.get('shared_with', []));
      allow create, update: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && (resource == null || resource.data.owner_uid == request.auth.uid)
                    && isSafeText(request.resource.data.get('name', ''), 80)
                    && isSafeText(request.resource.data.get('description', ''), 500)
                    && isSafeText(request.resource.data.get('owner_name', ''), 30)
                    && request.resource.data.visibility in ['friends', 'public']
                    && request.resource.data.get('shared_with', []) is list
                    && request.resource.data.get('shared_with', []).size() <= 200
                    && request.resource.data.routines is list
                    && request.resource.data.routines.size() <= 14
                    && request.resource.data.blocks is list
                    && request.resource.data.blocks.size() <= 20;
      allow delete: if isSignedIn() && resource.data.owner_uid == request.auth.uid;
    }

    // Programmes officiels Skullcrusher : lus par tout compte connecté,
    // écrits par l'administrateur. { deleted: true } masque un programme
    // intégré à l'app.
    match /official_programs/{programId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                    && programId.matches('^[A-Za-z0-9-]{1,60}$')
                    && (request.resource.data.get('deleted', false) == true
                        || (isSafeText(request.resource.data.name, 80)
                            && isSafeText(request.resource.data.get('description', ''), 500)
                            && request.resource.data.routines is list
                            && request.resource.data.routines.size() >= 1
                            && request.resource.data.routines.size() <= 14
                            && request.resource.data.get('blocks', []) is list
                            && request.resource.data.get('blocks', []).size() <= 20));
      allow delete: if isAdmin();
    }

    // Défi de la semaine : lu par tout compte connecté, écrit par
    // l'administrateur uniquement (id = semaine ISO, ex. 2026-W40).
    match /weekly_challenges/{week} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                    && week.matches('^[0-9]{4}-W[0-9]{2}$')
                    && request.resource.data.week == week
                    && isSafeText(request.resource.data.title, 60)
                    && isSafeText(request.resource.data.get('description', ''), 200)
                    && isSafeText(request.resource.data.get('exercise', ''), 80)
                    && request.resource.data.type in ['workouts', 'days', 'tonnage', 'sets', 'exercise_reps', 'exercise_tonnage', 'muscle_sets', 'records']
                    && request.resource.data.target is number
                    && request.resource.data.target >= 1;
      allow delete: if isAdmin();
    }

    // Envois entre amis : une routine ou un plan copié dans la boîte
    // « Reçus » d'un ami (amitié acceptée). Lus par l'expéditeur et le
    // destinataire ; supprimés quand le destinataire l'ajoute ou le refuse.
    function areFriends(a, b) {
      let path = /databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a);
      return exists(path) && get(path).data.status == 'accepted';
    }
    match /gifts/{giftId} {
      allow read: if isSignedIn() && (resource.data.to_uid == request.auth.uid
                    || resource.data.from_uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.from_uid == request.auth.uid
                    && request.resource.data.to_uid is string
                    && request.resource.data.to_uid != request.auth.uid
                    && areFriends(request.auth.uid, request.resource.data.to_uid)
                    && request.resource.data.kind in ['routine', 'plan']
                    && isSafeText(request.resource.data.name, 80)
                    && isSafeText(request.resource.data.get('from_name', ''), 30)
                    && request.resource.data.data is map;
      allow delete: if isSignedIn() && (resource.data.to_uid == request.auth.uid
                    || resource.data.from_uid == request.auth.uid);
    }

    // Notes de routines et de plans (1 à 5 étoiles), une par personne et
    // par cible ; pas de note sur sa propre routine.
    function notOwnRoutine(target) {
      return !target.matches('^routine_.*')
        || !exists(/databases/$(database)/documents/routines/$(target.split('_')[1]))
        || get(/databases/$(database)/documents/routines/$(target.split('_')[1])).data.owner_uid != request.auth.uid;
    }
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.target is string
                    && request.resource.data.target.matches('^(routine|plan)_[A-Za-z0-9-]{1,60}$')
                    && ratingId == request.resource.data.target + '_' + request.auth.uid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
                    && request.resource.data.keys().hasOnly(['target', 'uid', 'stars', 'updated_at'])
                    && notOwnRoutine(request.resource.data.target);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Signalements de profils : n'importe quel utilisateur connecté en crée
    // (un seul par personne et par profil : id = signaleur_signalé), seul
    // l'administrateur les lit et les traite.
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && reportId == request.auth.uid + '_' + request.resource.data.target_uid
                    && request.resource.data.reporter_uid == request.auth.uid
                    && request.resource.data.target_uid != request.auth.uid
                    && request.resource.data.reason in ['inappropriate', 'fake', 'harassment', 'spam', 'other']
                    && isSafeText(request.resource.data.get('comment', ''), 300)
                    && request.resource.data.status == 'open';
      allow read, update, delete: if isAdmin();
    }

    // Bibliothèque d'exercices : commune. Tout le monde lit et peut ajouter
    // un exercice (en son nom). Seul le créateur ou l'administrateur peut
    // le modifier ou le supprimer ; les anciens exercices sans created_by
    // ne sont modifiables que par l'administrateur.
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.created_by == request.auth.uid
                    && isSafeText(request.resource.data.name, 80);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid))
                    && request.resource.data.get('created_by', '') == resource.data.get('created_by', '')
                    && isSafeText(request.resource.data.name, 80)
                    // Fusion de doublons : redirection vers un autre nom.
                    && (!('merged_into' in request.resource.data) || isSafeText(request.resource.data.merged_into, 80));
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid);
    }

    // Amitiés : document friendships/{uidA_uidB} (uids triés). Celui qui
    // demande le crée en "pending", seul le destinataire peut l'accepter,
    // chacun des deux peut le supprimer (refus, annulation, retrait).
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users.hasAll([request.resource.data.from, request.resource.data.to])
                    && friendshipId == (request.resource.data.from < request.resource.data.to
                         ? request.resource.data.from + '_' + request.resource.data.to
                         : request.resource.data.to + '_' + request.resource.data.from);
      allow update: if isSignedIn()
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_at']);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Routines : chacune appartient à son créateur, avec une visibilité
    // "private" (lui seul), "friends" (les uids de shared_with) ou "public"
    // (tout le monde). Seul le propriétaire modifie le contenu ; les autres
    // ne peuvent toucher qu'à vote_count, de +1/-1, et uniquement en créant
    // ou supprimant leur propre vote dans le même lot.
    // L'administrateur peut aussi les lire toutes et s'attribuer celles sans
    // propriétaire (créées avant qu'elles deviennent personnelles).
    function routineReadable(data) {
      return data.get('owner_uid', null) == request.auth.uid
          || data.get('visibility', 'private') == 'public'
          || request.auth.uid in data.get('shared_with', []);
    }

    function routineVotePath(routineId) {
      return /databases/$(database)/documents/routines/$(routineId)/votes/$(request.auth.uid);
    }

    function validRoutine(data) {
      return isSafeText(data.get('name', ''), 80)
          && isSafeText(data.get('description', ''), 500)
          && isSafeText(data.get('owner_name', ''), 30)
          && data.get('visibility', 'private') in ['private', 'friends', 'public']
          && data.get('shared_with', []) is list
          && data.get('shared_with', []).size() <= 200;
    }

    match /routines/{routineId} {
      allow read: if isAdmin()
                  || (isSignedIn() && routineReadable(resource.data));
      allow create: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && request.resource.data.get('vote_count', 0) == 0
                    && validRoutine(request.resource.data);
      allow update: if isSignedIn() && (
                      // le propriétaire : tout sauf le compteur de votes
                      (resource.data.get('owner_uid', null) == request.auth.uid
                        && request.resource.data.owner_uid == request.auth.uid
                        && request.resource.data.get('vote_count', 0) == resource.data.get('vote_count', 0)
                        && validRoutine(request.resource.data)) ||
                      // un autre utilisateur qui vote / retire son vote
                      (resource.data.get('owner_uid', null) != request.auth.uid
                        && routineReadable(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vote_count'])
                        && ((request.resource.data.vote_count == resource.data.get('vote_count', 0) + 1
                              && !exists(routineVotePath(routineId)) && existsAfter(routineVotePath(routineId))) ||
                            (request.resource.data.vote_count == resource.data.get('vote_count', 0) - 1
                              && exists(routineVotePath(routineId)) && !existsAfter(routineVotePath(routineId))))) ||
                      // l'administrateur récupère une ancienne routine sans propriétaire
                      (isAdmin() && resource.data.get('owner_uid', null) == null
                        && request.resource.data.owner_uid == request.auth.uid)
                    );
      allow delete: if isSignedIn()
                    && resource.data.owner_uid == request.auth.uid;

      match /votes/{voterId} {
        allow read: if isSignedIn() && voterId == request.auth.uid;
        allow create: if isSignedIn() && voterId == request.auth.uid
                      && get(/databases/$(database)/documents/routines/$(routineId)).data.owner_uid != request.auth.uid
                      && getAfter(/databases/$(database)/documents/routines/$(routineId)).data.vote_count
                           == get(/databases/$(database)/documents/routines/$(routineId)).data.get('vote_count', 0) + 1;
        allow delete: if isSignedIn() && voterId == request.auth.uid
                      && getAfter(/databases/$(database)/documents/routines/$(routineId)).data.vote_count
                           == get(/databases/$(database)/documents/routines/$(routineId)).data.get('vote_count', 0) - 1;
      }
    }

    // Données privées de l'utilisateur (connexion Spotify) : lui seul.
    match /user_private/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Liste de ses propres votes (pour afficher les 👍 déjà donnés).
    match /user_votes/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Séances : privées par défaut. Lecture par le propriétaire, ou par
    // n'importe quel utilisateur connecté si la séance est partagée sur le
    // feed. Seul le propriétaire modifie/supprime — sauf les réactions 🤘
    // (`props`), que chacun peut poser ou retirer pour lui-même sur une
    // séance partagée.
    //
    // Entraînés ensemble : les amis cités dans `partners` lisent la séance
    // (et ses séries), et peuvent seulement s'en retirer eux-mêmes.
    match /workouts/{workoutId} {
      function validPartners(data) {
        return data.get('partners', []) is list
               && data.get('partners', []).size() <= 10
               && !(request.auth.uid in data.get('partners', []));
      }
      // Partage « amis seulement » : lisible par les amis acceptés du
      // propriétaire (friends_share == true).
      function friendsShared(data) {
        return data.get('friends_share', false) == true && areFriends(request.auth.uid, data.owner_uid);
      }
      allow read: if isSignedIn() && (
                    resource.data.owner_uid == request.auth.uid ||
                    resource.data.get('shared', false) == true ||
                    friendsShared(resource.data) ||
                    request.auth.uid in resource.data.get('partners', [])
                  );
      allow create: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && validPartners(request.resource.data);
      allow update: if isSignedIn() && (
                      (resource.data.owner_uid == request.auth.uid &&
                       request.resource.data.owner_uid == request.auth.uid &&
                       validPartners(request.resource.data)) ||
                      (request.auth.uid in resource.data.get('partners', []) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partners']) &&
                       request.resource.data.partners == resource.data.partners.removeAll([request.auth.uid])) ||
                      ((resource.data.get('shared', false) == true || friendsShared(resource.data)) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['props']) &&
                       request.resource.data.get('props', {}).diff(resource.data.get('props', {})).affectedKeys().hasOnly([request.auth.uid]))
                    );
      allow delete: if isSignedIn()
                    && resource.data.owner_uid == request.auth.uid;

      match /sets/{setId} {
        allow read: if isSignedIn() && (
                      resource.data.owner_uid == request.auth.uid ||
                      workoutDoc(workoutId).owner_uid == request.auth.uid ||
                      workoutDoc(workoutId).get('shared', false) == true ||
                      (workoutDoc(workoutId).get('friends_share', false) == true && areFriends(request.auth.uid, workoutDoc(workoutId).owner_uid)) ||
                      request.auth.uid in workoutDoc(workoutId).get('partners', [])
                    );
        allow create: if isSignedIn()
                      && request.resource.data.owner_uid == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.owner_uid == request.auth.uid
                      && request.resource.data.owner_uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.owner_uid == request.auth.uid;
      }
    }

    // Requêtes en GROUPE DE COLLECTIONS sur les séries (Stats, fiches
    // d'exercice) : uniquement ses propres séries. Les requêtes de l'app
    // filtrent toutes sur owner_uid == uid, ce qui rend la règle prouvable.
    match /{path=**}/sets/{setId} {
      allow read: if isSignedIn() && resource.data.owner_uid == request.auth.uid;
    }
  }
}
