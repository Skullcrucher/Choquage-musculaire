rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ouvert à tout compte connecté (email/mot de passe). La confidentialité
    // repose sur owner_uid : chacun ne lit que ses propres séances et
    // routines, plus les séances partagées sur le feed (shared == true).
    function isSignedIn() {
      return request.auth != null;
    }

    // Administrateur de l'app : peut modifier toute la bibliothèque
    // d'exercices et récupère les routines créées avant qu'elles
    // deviennent personnelles. Même email que ADMIN_EMAIL dans js/db.js.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bouvet.clement@gmail.com';
    }

    function workoutDoc(workoutId) {
      return get(/databases/$(database)/documents/workouts/$(workoutId)).data;
    }

    // Profils (pseudo + photo) : chacun lit tout le monde (pour le feed),
    // mais ne modifie que le sien.
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Bibliothèque d'exercices : commune. Tout le monde lit et peut ajouter
    // un exercice (en son nom). Seul le créateur ou l'administrateur peut
    // le modifier ou le supprimer ; les anciens exercices sans created_by
    // ne sont modifiables que par l'administrateur.
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.created_by == request.auth.uid;
      allow update: if (isAdmin() || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid))
                    && request.resource.data.get('created_by', '') == resource.data.get('created_by', '');
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.get('created_by', '') == request.auth.uid);
    }

    // Routines : personnelles. L'administrateur peut aussi les lire toutes
    // et s'attribuer celles sans propriétaire (créées avant ce changement) :
    // c'est ce que fait l'app automatiquement à son premier chargement.
    match /routines/{routineId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.owner_uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && (resource.data.get('owner_uid', null) == request.auth.uid ||
                        (isAdmin() && resource.data.get('owner_uid', null) == null));
      allow delete: if isSignedIn()
                    && resource.data.owner_uid == request.auth.uid;
    }

    // Séances : privées par défaut. Lecture par le propriétaire, ou par
    // n'importe quel utilisateur connecté si la séance est partagée sur le
    // feed. Seul le propriétaire modifie/supprime — sauf les réactions 🤘
    // (`props`), que chacun peut poser ou retirer pour lui-même sur une
    // séance partagée.
    match /workouts/{workoutId} {
      allow read: if isSignedIn() && (
                    resource.data.owner_uid == request.auth.uid ||
                    resource.data.get('shared', false) == true
                  );
      allow create: if isSignedIn()
                    && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isSignedIn() && (
                      (resource.data.owner_uid == request.auth.uid &&
                       request.resource.data.owner_uid == request.auth.uid) ||
                      (resource.data.get('shared', false) == true &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['props']) &&
                       request.resource.data.get('props', {}).diff(resource.data.get('props', {})).affectedKeys().hasOnly([request.auth.uid]))
                    );
      allow delete: if isSignedIn()
                    && resource.data.owner_uid == request.auth.uid;

      match /sets/{setId} {
        allow read: if isSignedIn() && (
                      resource.data.owner_uid == request.auth.uid ||
                      workoutDoc(workoutId).owner_uid == request.auth.uid ||
                      workoutDoc(workoutId).get('shared', false) == true
                    );
        allow create: if isSignedIn()
                      && request.resource.data.owner_uid == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.owner_uid == request.auth.uid
                      && request.resource.data.owner_uid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.owner_uid == request.auth.uid;
      }
    }

    // Requêtes en GROUPE DE COLLECTIONS sur les séries (Stats, fiches
    // d'exercice) : uniquement ses propres séries. Les requêtes de l'app
    // filtrent toutes sur owner_uid == uid, ce qui rend la règle prouvable.
    match /{path=**}/sets/{setId} {
      allow read: if isSignedIn() && resource.data.owner_uid == request.auth.uid;
    }
  }
}
